# Copie para .env e preencha. Nunca suba o .env para o GitHub.

# Token do @BotFather
TELEGRAM_TOKEN=

# Chave do Google AI Studio (aistudio.google.com > Get API key)
GEMINI_API_KEY=

# Confira o nome exato e a cota gratuita no AI Studio. Os Flash-Lite têm
# muito mais chamadas por dia no plano gratuito do que os Flash.
GEMINI_MODELO=gemini-3.5-flash-lite
# Reservas para quando o modelo acima estiver sobrecarregado (vírgula entre eles).
# Deixe vazio para o bot descobrir sozinho quais modelos a sua chave pode usar.
GEMINI_RESERVAS=

# ID do grupo da turma (mande /id no grupo para descobrir; é negativo).
# Vazio = o bot aceita qualquer grupo em que estiver.
GRUPO_ID=

# Seu ID de usuário no Telegram (mande /id ao bot). Só você pode usar /gerar.
ADMIN_ID=

# Quantos moradores a IA cria além do Sim inicial (sorteado entre os dois)
MORADORES_MIN=2
MORADORES_MAX=4

# Ritmo do mundo, em segundos
RODADA_SEGUNDOS=30
OCIOSO_SEGUNDOS=120
INTERVALO_POR_PESSOA=30

# Freio de segurança: o bot para de chamar a IA depois disto, no dia
LIMITE_DIARIO=400

MAX_CARACTERES=280

# ---- O mod do jogo ----
# Ao iniciar, o bot empacota a pasta mod-npcgen/ e instala na pasta Mods do
# jogo (só quando o npcgen.py mudou). O jogo só carrega a versão nova quando
# é reiniciado. EMPACOTAR_MOD=0 desliga isso.
EMPACOTAR_MOD=1
# Pasta Mods do The Sims 4. Vazio = o bot procura em Documentos/Documents
# (inclusive no OneDrive). Ex.: D:/OneDrive/Documentos/Electronic Arts/The Sims 4/Mods
SIMS_MODS=
# python.exe da versão 3.7. Vazio = usa "py -3.7".
PYTHON37=

# Onde o mod lê comandos.json e escreve estado.json. Vazio = a pasta "troca"
# ao lado do mod instalado (Mods/npcgen/troca), achada sozinha.
PASTA_TROCA=
PASTA_DADOS=dados
ARQUIVO_SIMS=sims.json
